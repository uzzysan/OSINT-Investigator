# ---------------------------------------------------------------------------
# OSINT Investigator - runtime configuration
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# Network -------------------------------------------------------------------
# Address to bind. 127.0.0.1 = local only. 0.0.0.0 = reachable on the network.
OSINT_BIND_ADDR=127.0.0.1
# Preferred port. If taken, the installer/service scans upward for a free one
# and writes the chosen port to runtime/port.
OSINT_PORT=8787
# Public base URL, used when generating links inside reports and MCP responses.
OSINT_PUBLIC_URL=http://127.0.0.1:8787

# Storage -------------------------------------------------------------------
# SQLite database file.
OSINT_DB_PATH=./data/osint.sqlite
# Directory for attachments (photos, scans, documents), content-addressed.
OSINT_BLOB_DIR=./data/blobs
# Maximum single upload size in megabytes.
OSINT_MAX_UPLOAD_MB=256

# Access --------------------------------------------------------------------
# Deployment profile: "solo" (no login, trusted network) or "token".
OSINT_AUTH_MODE=solo
# Shared bearer token used by AI agents when OSINT_AUTH_MODE=token.
# Generate with: openssl rand -hex 32
OSINT_API_TOKEN=

# MCP -----------------------------------------------------------------------
# Enable the streamable-HTTP MCP endpoint at /mcp
OSINT_MCP_HTTP_ENABLED=true

# Entity resolution ---------------------------------------------------------
# Score above which a duplicate is surfaced as a suggestion (0.0 - 1.0).
OSINT_ER_SUGGEST_THRESHOLD=0.62
# Score above which a suggestion is flagged "strong".
OSINT_ER_STRONG_THRESHOLD=0.85
# Run matching across all cases, not just within the current one.
OSINT_ER_CROSS_CASE=true

# Operations ----------------------------------------------------------------
# trace | debug | info | warn | error
OSINT_LOG_LEVEL=info
# Nightly local backup of the SQLite file + blob manifest.
OSINT_BACKUP_ENABLED=true
OSINT_BACKUP_DIR=./data/backups
OSINT_BACKUP_KEEP=14
